---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import Shell from '../components/Shell.astro';
import Icon from '../components/Icon.astro';
import Button from '../components/Button.astro';
import buyers from '../data/buyers.json';
import site from '../data/site.json';

const what = [
  { icon: 'shield-check', title: 'Committed sellers', body: 'Every mandate has a signed engagement and an owner who has worked through the decision, the valuation range and the timeline before you see anything.' },
  { icon: 'file-text', title: 'Prepared information', body: 'Normalised earnings with the adjustments shown, three years of statements, and a memorandum written to be checked rather than admired.' },
  { icon: 'clock', title: 'A process that moves', body: 'Coordinated diligence, managed data room access and a timetable. Slow deals cost you more than expensive ones.' },
];

const crumbs = [{ href: '/buyers', label: 'Buyers' }];
---

<Base
  crumbs={crumbs}
  title="Buyer mandates | Acquire a Singapore SME"
  description="Live buyer mandates and acquisition criteria registration. Screened sell-side opportunities from committed Singapore SME owners, prepared for investment committee review."
>
  <PageHeader
    eyebrow="For buyers"
    title="Buyers currently looking"
    intro="Live mandates from our buyer network. If you are acquiring, register your criteria and we will come to you when something fits. No mailing list."
    crumbs={crumbs}
  >
    <Button href="/contact?enquiry=buyer" variant="ink">Register your criteria</Button>
  </PageHeader>

  <section class="max-w-wrap mx-auto px-5 lg:px-8 pb-24">
    <p class="mb-8 font-mono text-xs text-ink-3 dark:text-[#a9b4c2] reveal">(sample rows)</p>
    <div class="grid gap-3">
      {buyers.rows.map((r, i) => (
        <Shell radius="1.5rem" class="reveal transition-transform duration-700 ease hover:-translate-y-0.5" coreClass="p-6 grid grid-cols-[1fr_auto] gap-4 items-center" data-d={String(i % 4)}>
          <div>
            <p class="font-medium">{r.title}</p>
            <p class="mt-1 text-sm text-ink-2 dark:text-[#a9b4c2] font-light">{r.detail}</p>
          </div>
          <p class="font-mono text-sm whitespace-nowrap">{r.range}</p>
        </Shell>
      ))}
    </div>
  </section>

  <section class="max-w-wrap mx-auto px-5 lg:px-8 pb-24">
    <div class="max-w-[60ch] reveal">
      <h2 class="text-3xl md:text-4xl font-medium tracking-[-0.03em] leading-[1.05]">The problem is not finding businesses. It is finding sellers.</h2>
      <p class="mt-6 text-lg text-ink-2 dark:text-[#a9b4c2] font-light leading-relaxed">
        Most SME deal flow is owners testing a number. They engage, they enjoy the attention, and they withdraw at term
        sheet, after you have spent six weeks and a diligence budget.
      </p>
    </div>
    <div class="mt-12 grid grid-cols-1 md:grid-cols-3 gap-3">
      {what.map((w, i) => (
        <Shell radius="2rem" class="reveal" coreClass="p-8 h-full flex flex-col gap-8" data-d={String(i)}>
          <Icon name={w.icon} class="text-4xl text-accent dark:text-[#7fd1b3]" />
          <div>
            <h3 class="text-lg font-medium tracking-tight">{w.title}</h3>
            <p class="mt-3 text-sm text-ink-2 dark:text-[#a9b4c2] font-light">{w.body}</p>
          </div>
        </Shell>
      ))}
    </div>
  </section>

  <section class="max-w-wrap mx-auto px-5 lg:px-8 pb-28 lg:pb-40">
    <Shell radius="2.5rem" pad="2" class="reveal" coreClass="p-8 md:p-14 grid grid-cols-1 lg:grid-cols-12 gap-10">
      <div class="lg:col-span-5">
        <h2 class="text-2xl md:text-3xl font-medium tracking-[-0.02em]">Where we stand, said plainly</h2>
        <p class="mt-5 text-ink-2 dark:text-[#a9b4c2] font-light leading-relaxed">
          On a sale mandate we act for the seller. Buyers who transact through us pay a separate fee for buy-side
          process work: screened deal flow, process management and data room coordination. Both fees are disclosed to
          both sides before anything is signed.
        </p>
        <p class="mt-4 text-ink-2 dark:text-[#a9b4c2] font-light leading-relaxed">
          If you need someone negotiating against a seller we represent, engage your own advisor and we will work with
          them professionally.
        </p>
      </div>
      <div class="lg:col-span-7">
        <h3 class="font-medium">Useful to include when you register</h3>
        <ul class="mt-5 space-y-3 text-sm text-ink-2 dark:text-[#a9b4c2] font-light">
          <li class="flex gap-3"><Icon name="check-circle" class="text-accent dark:text-[#7fd1b3] text-lg mt-0.5" /><span>Sectors you understand, and any you will not consider</span></li>
          <li class="flex gap-3"><Icon name="check-circle" class="text-accent dark:text-[#7fd1b3] text-lg mt-0.5" /><span>Revenue and EBITDA range you are targeting</span></li>
          <li class="flex gap-3"><Icon name="check-circle" class="text-accent dark:text-[#7fd1b3] text-lg mt-0.5" /><span>Cheque size and how it is funded</span></li>
          <li class="flex gap-3"><Icon name="check-circle" class="text-accent dark:text-[#7fd1b3] text-lg mt-0.5" /><span>Majority, full ownership, or backing a rolled-over owner</span></li>
          <li class="flex gap-3"><Icon name="check-circle" class="text-accent dark:text-[#7fd1b3] text-lg mt-0.5" /><span>Anything you have already seen, so we do not re-introduce it</span></li>
        </ul>
        <div class="mt-8 flex flex-col sm:flex-row gap-3">
          <Button href={`mailto:${site.email}?subject=Buyer%20registration`} variant="ink" icon="envelope-simple">Email your criteria</Button>
          <Button href="/contact?enquiry=buyer" variant="ring">Use the contact form</Button>
        </div>
      </div>
    </Shell>
  </section>
</Base>
