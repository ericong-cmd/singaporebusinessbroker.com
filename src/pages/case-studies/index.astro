---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PageHeader from '../../components/PageHeader.astro';
import Shell from '../../components/Shell.astro';
import FinalCta from '../../components/home/FinalCta.astro';

const cases = (await getCollection('cases')).sort((a, b) => a.data.order - b.data.order);

const crumbs = [{ href: '/case-studies', label: 'Transactions' }];
---

<Base
  crumbs={crumbs}
  title="Transactions | Singapore Business Broker"
  description="Completed Singapore SME transactions, anonymised: sector, size, buyer type and year. Three F&B businesses sold from S$3m to S$20m revenue."
>
  <PageHeader
    eyebrow="Transactions"
    title="Recent transactions, anonymised"
    intro="Completed transactions, anonymised. We never name a client without written permission, which is why these entries describe the shape of a deal rather than the company."
    crumbs={crumbs}
  />

  <section class="max-w-wrap mx-auto px-5 lg:px-8 pb-28 lg:pb-40">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
      {cases.map((c, i) => (
        <Shell radius="2rem" class="reveal" coreClass="p-8 h-full flex flex-col justify-between gap-8" data-d={String((i % 2) + 1)}>
          <div>
            <p class="text-[10px] uppercase tracking-[0.18em] text-ink-3 dark:text-[#a9b4c2]">{c.data.sectorLabel}</p>
            <h2 class="mt-3 text-xl font-medium tracking-tight">
              <a class="hover:text-accent dark:hover:text-[#7fd1b3] transition-colors duration-500 ease" href={`/case-studies/${c.slug}`}>{c.data.title}</a>
            </h2>
            <p class="mt-3 text-sm text-ink-2 dark:text-[#a9b4c2] font-light">{c.data.description}</p>
          </div>
          <dl class="grid grid-cols-3 gap-4 text-sm">
            <div><dt class="text-ink-3 dark:text-[#a9b4c2] text-xs">Size</dt><dd class="font-mono mt-1 text-[13px]">{c.data.revenue}</dd></div>
            <div><dt class="text-ink-3 dark:text-[#a9b4c2] text-xs">Buyer</dt><dd class="font-mono mt-1 text-[13px]">{c.data.buyerType}</dd></div>
            <div><dt class="text-ink-3 dark:text-[#a9b4c2] text-xs">Completed</dt><dd class="font-mono mt-1 text-[13px]">{c.data.completedYear}</dd></div>
          </dl>
        </Shell>
      ))}
    </div>
  </section>

  <FinalCta />
</Base>
