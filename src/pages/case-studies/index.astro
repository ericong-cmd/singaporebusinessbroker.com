---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PageHeader from '../../components/PageHeader.astro';
import Shell from '../../components/Shell.astro';
import FinalCta from '../../components/home/FinalCta.astro';

const cases = (await getCollection('cases')).sort((a, b) => a.data.order - b.data.order);
---

<Base
  title="Transactions | Singapore Business Broker"
  description="Anonymised Singapore SME transactions: sector, size band, buyer type and outcome. Sample entries pending publication of live figures."
>
  <PageHeader
    eyebrow="Transactions"
    title="Recent transactions, anonymised"
    intro="Sector, size and outcome only. We never name a client without written permission, which is why these entries describe the shape of a deal rather than the company."
    crumbs={[{ href: '/case-studies', label: 'Transactions' }]}
  />

  <section class="max-w-wrap mx-auto px-5 lg:px-8 pb-28 lg:pb-40">
    <p class="mb-8 font-mono text-xs text-ink-3 dark:text-[#a9b4c2] reveal">(sample entries)</p>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
      {cases.map((c, i) => (
        <Shell radius="2rem" class="reveal" coreClass="p-8 h-full flex flex-col justify-between gap-8" data-d={String((i % 2) + 1)}>
          <div>
            <p class="text-[10px] uppercase tracking-[0.18em] text-ink-3 dark:text-[#a9b4c2]">{c.data.sectorLabel}</p>
            <h2 class="mt-3 text-xl font-medium tracking-tight">
              <a class="hover:text-accent dark:hover:text-[#7fd1b3] transition-colors duration-500 ease" href={`/case-studies/${c.slug}`}>{c.data.title}</a>
            </h2>
            <p class="mt-3 text-sm text-ink-2 dark:text-[#a9b4c2] font-light">{c.data.description}</p>
          </div>
          <dl class="grid grid-cols-3 gap-4 text-sm">
            <div><dt class="text-ink-3 dark:text-[#a9b4c2] text-xs">Size</dt><dd class="font-mono mt-1 text-[13px]">{c.data.revenue}</dd></div>
            <div><dt class="text-ink-3 dark:text-[#a9b4c2] text-xs">Buyer</dt><dd class="font-mono mt-1 text-[13px]">{c.data.buyerType}</dd></div>
            <div><dt class="text-ink-3 dark:text-[#a9b4c2] text-xs">Close</dt><dd class="font-mono mt-1 text-[13px]">{c.data.timeToClose}</dd></div>
          </dl>
        </Shell>
      ))}
    </div>
  </section>

  <FinalCta />
</Base>
