---
import Base from '../layouts/Base.astro';
import Hero from '../components/home/Hero.astro';
import ProofStrip from '../components/home/ProofStrip.astro';
import WhyUs from '../components/home/WhyUs.astro';
import Process from '../components/home/Process.astro';
import ValuationTeaser from '../components/home/ValuationTeaser.astro';
import CaseStudies from '../components/home/CaseStudies.astro';
import Sectors from '../components/home/Sectors.astro';
import BuyerDemand from '../components/home/BuyerDemand.astro';
import Faq from '../components/Faq.astro';
import FinalCta from '../components/home/FinalCta.astro';
import faq from '../data/faq.json';
import { service, faqPage } from '../lib/schema';

const schema = [
  service('Sell-side M&A advisory for Singapore SMEs'),
  faqPage(faq),
];
---

<Base
  title="Business Broker Singapore | Sell Your Business Confidentially"
  description="Sell-side M&A advisors for Singapore SME owners with S$3m to S$30m businesses. Free valuation estimate, confidential process, vetted buyer network."
  schema={schema}
>
  <Hero />
  <ProofStrip />
  <WhyUs />
  <Process />
  <ValuationTeaser />
  <CaseStudies />
  <Sectors />
  <BuyerDemand />
  <Faq items={faq} />
  <FinalCta />
</Base>
