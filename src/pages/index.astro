---
import Base from '../layouts/Base.astro';
import Hero from '../components/home/Hero.astro';
import ProofStrip from '../components/home/ProofStrip.astro';
import WhyUs from '../components/home/WhyUs.astro';
import Process from '../components/home/Process.astro';
import ValuationTeaser from '../components/home/ValuationTeaser.astro';
import CaseStudies from '../components/home/CaseStudies.astro';
import Sectors from '../components/home/Sectors.astro';
import BuyerDemand from '../components/home/BuyerDemand.astro';
import Faq from '../components/Faq.astro';
import FinalCta from '../components/home/FinalCta.astro';
import faq from '../data/faq.json';

const schema = [
  {
    '@type': 'Service',
    name: 'Sell-side M&A advisory for Singapore SMEs',
    serviceType: 'Business brokerage and sell-side M&A advisory',
    provider: { '@id': `${Astro.site}#org` },
    areaServed: { '@type': 'Country', name: 'Singapore' },
    description:
      'Confidential sale process for Singapore businesses worth S$3m to S$30m: valuation, buyer search, negotiation and completion.',
  },
  {
    '@type': 'FAQPage',
    mainEntity: faq.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
];
---

<Base
  title="Singapore Business Broker | Sell your business confidentially, at the right price"
  description="Sell-side M&A advisors for Singapore SME owners with S$3m to S$30m businesses. Free valuation estimate, confidential process, vetted buyer network."
  schema={schema}
>
  <Hero />
  <ProofStrip />
  <WhyUs />
  <Process />
  <ValuationTeaser />
  <CaseStudies />
  <Sectors />
  <BuyerDemand />
  <Faq items={faq} />
  <FinalCta />
</Base>
