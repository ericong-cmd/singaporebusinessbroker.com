---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import Shell from '../components/Shell.astro';
import Icon from '../components/Icon.astro';
import Button from '../components/Button.astro';
import site from '../data/site.json';

const covers = [
  'What you have built, and what you want afterwards',
  'A first view on what the business is likely to fetch today',
  'What would change that number, and how long it would take',
  'Whether selling now actually serves you, including when it does not',
];

const bring = [
  'Roughly what the business turns over, and what it earned last year',
  'How long you have been running it, and how much of it you own',
  'When you would like to be out, even if the answer is "not sure yet"',
];
---

<Base
  title="Book a confidential call | Singapore Business Broker"
  description="Request a confidential 30 minute call about selling your Singapore business. No fee, no obligation, and nothing leaves the conversation."
>
  <PageHeader
    eyebrow="30 minutes, confidential"
    title="Book a confidential call"
    intro="No fee and no obligation. You do not have to name your company to have the conversation."
    crumbs={[{ href: '/book-a-call', label: 'Book a call' }]}
  />

  <section class="max-w-wrap mx-auto px-5 lg:px-8 pb-28 lg:pb-40">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12">
      <div class="lg:col-span-7 reveal">
        <Shell radius="2rem" pad="2" shadow="frame" coreClass="p-8 md:p-12">
          <Icon name="envelope-simple" class="text-4xl text-accent dark:text-[#7fd1b3]" />
          <h2 class="mt-6 text-2xl md:text-3xl font-medium tracking-[-0.02em]">Email us to arrange a time</h2>
          <p class="mt-4 text-ink-2 dark:text-[#a9b4c2] font-light leading-relaxed max-w-[52ch]">
            The button opens a new email to us with the subject already filled in. Tell us roughly when suits you and
            we will come back with a time, usually the same working day.
          </p>

          <div class="mt-8 flex flex-col sm:flex-row gap-3">
            <Button href={site.bookingUrl} variant="ink" icon="envelope-simple">Email to arrange a call</Button>
            <Button href={`tel:${site.phoneHref}`} variant="ring" icon="phone">{site.phoneDisplay}</Button>
          </div>

          <p class="mt-8 text-xs text-ink-3 dark:text-[#a9b4c2] font-light">
            If your mail app does not open, write to
            <a class="underline" href={`mailto:${site.email}`}>{site.email}</a> with the subject
            "{site.enquirySubject}".
          </p>

          <div class="mt-10 pt-8 border-t border-black/5 dark:border-white/[0.08]">
            <h3 class="text-sm font-medium">Useful to include</h3>
            <ul class="mt-4 space-y-3">
              {bring.map((b) => (
                <li class="flex gap-3 text-sm text-ink-2 dark:text-[#a9b4c2] font-light">
                  <Icon name="check-circle" class="text-accent dark:text-[#7fd1b3] text-lg mt-0.5" />
                  <span>{b}</span>
                </li>
              ))}
            </ul>
          </div>
        </Shell>
      </div>

      <div class="lg:col-span-5 reveal" data-d="1">
        <h2 class="text-2xl font-medium tracking-tight">What the call covers</h2>
        <ul class="mt-6 space-y-4">
          {covers.map((c) => (
            <li class="flex gap-3 text-sm text-ink-2 dark:text-[#a9b4c2] font-light">
              <Icon name="check-circle" class="text-accent dark:text-[#7fd1b3] text-lg mt-0.5" />
              <span>{c}</span>
            </li>
          ))}
        </ul>

        <Shell radius="1.5rem" class="mt-10" coreClass="p-6">
          <h3 class="font-medium">Rather see a number first?</h3>
          <p class="mt-3 text-sm text-ink-2 dark:text-[#a9b4c2] font-light">
            The estimator takes two minutes, shows a range on screen and sends the report to your email automatically.
          </p>
          <p class="mt-3 text-sm"><a class="text-accent dark:text-[#7fd1b3] hover:underline" href="/valuation">Open the estimator</a></p>
        </Shell>

        <Shell radius="1.5rem" class="mt-4" coreClass="p-6">
          <h3 class="font-medium">If you are not ready to sell</h3>
          <p class="mt-3 text-sm text-ink-2 dark:text-[#a9b4c2] font-light">
            Most owners we speak to are twelve to twenty-four months out. That is the window where preparation still
            changes the price, so it is the most useful time to call.
          </p>
        </Shell>
      </div>
    </div>
  </section>
</Base>
