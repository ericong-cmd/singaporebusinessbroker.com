---
import type { GetStaticPaths } from 'astro';
import { getCollection, type CollectionEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PageHeader from '../../components/PageHeader.astro';
import FinalCta from '../../components/home/FinalCta.astro';
import { article, advisors } from '../../lib/schema';
import Byline from '../../components/Byline.astro';

export const getStaticPaths: GetStaticPaths = async () => {
  const entries = await getCollection('insights', ({ data }) => !data.draft);
  return entries.map((entry) => ({ params: { slug: entry.slug }, props: { entry } }));
};

interface Props { entry: CollectionEntry<'insights'> }
const { entry } = Astro.props;
const { Content } = await entry.render();
const d = entry.data;
// Named attribution only once a person has actually reviewed the page.
const reviewedBy = d.reviewed ? (advisors.find((a) => a.founder) ?? advisors[0] ?? null) : null;

const schema = [
  article({
    headline: d.heading,
    description: d.description,
    path: `/insights/${entry.slug}`,
    published: d.published,
    modified: d.updated ?? d.published,
    reviewedBy,
  }),
];

const crumbs = [{ href: '/insights', label: 'Insights' }, { href: `/insights/${entry.slug}`, label: d.title }];
---

<Base
  crumbs={crumbs} title={`${d.title} | Singapore Business Broker`} description={d.description} schema={schema}>
  <PageHeader
    eyebrow="Insight"
    title={d.heading}
    intro={d.description}
    crumbs={crumbs}
  />
  <section class="max-w-wrap mx-auto px-5 lg:px-8 pb-28 lg:pb-40">
    <Byline published={d.published} updated={d.updated} author={reviewedBy?.name} readingMinutes={d.readingMinutes} class="reveal mb-10" />
    <div class="prose-sbb reveal"><Content /></div>
  </section>
  <FinalCta />
</Base>
