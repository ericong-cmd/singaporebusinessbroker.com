---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PageHeader from '../../components/PageHeader.astro';
import Shell from '../../components/Shell.astro';
import FinalCta from '../../components/home/FinalCta.astro';

const posts = (await getCollection('insights', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.published.valueOf() - a.data.published.valueOf()
);
const fmt = (d: Date) => d.toLocaleDateString('en-SG', { year: 'numeric', month: 'long', day: 'numeric' });
---

<Base
  title="Insights | Singapore Business Broker"
  description="Notes on selling a business in Singapore: what buyers pay for, market conditions and the mechanics of a sale process."
>
  <PageHeader
    eyebrow="Insights"
    title="Notes on selling a Singapore business"
    intro="Short pieces on what we see in live processes."
    crumbs={[{ href: '/insights', label: 'Insights' }]}
  />
  <section class="max-w-wrap mx-auto px-5 lg:px-8 pb-28 lg:pb-40">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
      {posts.map((p, i) => (
        <Shell radius="2rem" class="reveal" coreClass="p-8 h-full" data-d={String((i % 2) + 1)}>
          <p class="font-mono text-xs text-ink-3 dark:text-[#a9b4c2]">{fmt(p.data.published)}</p>
          <h2 class="mt-3 text-xl font-medium tracking-tight">
            <a class="hover:text-accent dark:hover:text-[#7fd1b3] transition-colors duration-500 ease" href={`/insights/${p.slug}`}>{p.data.title}</a>
          </h2>
          <p class="mt-3 text-sm text-ink-2 dark:text-[#a9b4c2] font-light">{p.data.description}</p>
        </Shell>
      ))}
    </div>
  </section>
  <FinalCta />
</Base>
