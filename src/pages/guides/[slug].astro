---
import type { GetStaticPaths } from 'astro';
import { getCollection, type CollectionEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PageHeader from '../../components/PageHeader.astro';
import FinalCta from '../../components/home/FinalCta.astro';

export const getStaticPaths: GetStaticPaths = async () => {
  const entries = await getCollection('guides', ({ data }) => !data.draft);
  return entries.map((entry) => ({ params: { slug: entry.slug }, props: { entry } }));
};

interface Props { entry: CollectionEntry<'guides'> }
const { entry } = Astro.props;
const { Content } = await entry.render();
const d = entry.data;

const others = (await getCollection('guides', ({ data }) => !data.draft))
  .filter((g) => g.slug !== entry.slug)
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 3);

const schema = [{
  '@type': 'Article',
  headline: d.heading,
  description: d.description,
  datePublished: d.updated.toISOString(),
  dateModified: d.updated.toISOString(),
  author: { '@id': `${Astro.site}#org` },
  publisher: { '@id': `${Astro.site}#org` },
  mainEntityOfPage: new URL(`/guides/${entry.slug}`, Astro.site).href,
}];
---

<Base title={`${d.title} | Singapore Business Broker`} description={d.description} schema={schema}>
  <PageHeader
    eyebrow={`Guide, ${d.readingMinutes} min read`}
    title={d.heading}
    intro={d.description}
    crumbs={[{ href: '/guides', label: 'Guides' }, { href: `/guides/${entry.slug}`, label: d.title }]}
  />

  <section class="max-w-wrap mx-auto px-5 lg:px-8 pb-24">
    <div class="prose-sbb reveal"><Content /></div>
  </section>

  <section class="max-w-wrap mx-auto px-5 lg:px-8 pb-28 lg:pb-40">
    <h2 class="text-2xl md:text-3xl font-medium tracking-[-0.02em] reveal">Read next</h2>
    <div class="mt-8 grid grid-cols-1 md:grid-cols-3 gap-3">
      {others.map((g, i) => (
        <a href={`/guides/${g.slug}`} class="reveal group rounded-[1.5rem] bg-black/5 dark:bg-white/[0.04] ring-1 ring-black/5 dark:ring-white/[0.08] p-1.5 transition-transform duration-700 ease hover:-translate-y-0.5" data-d={String(i)}>
          <div class="rounded-[calc(1.5rem-0.375rem)] bg-white dark:bg-night-core p-6 h-full">
            <p class="font-medium group-hover:text-accent dark:group-hover:text-[#7fd1b3] transition-colors duration-500 ease">{g.data.title}</p>
            <p class="mt-2 text-sm text-ink-2 dark:text-[#a9b4c2] font-light">{g.data.description}</p>
          </div>
        </a>
      ))}
    </div>
  </section>

  <FinalCta />
</Base>
