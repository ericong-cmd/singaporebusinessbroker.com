---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PageHeader from '../../components/PageHeader.astro';
import FinalCta from '../../components/home/FinalCta.astro';

const guides = (await getCollection('guides', ({ data }) => !data.draft)).sort(
  (a, b) => a.data.order - b.data.order
);

const crumbs = [{ href: '/guides', label: 'Guides' }];
---

<Base
  crumbs={crumbs}
  title="Guides to selling a business in Singapore | Singapore Business Broker"
  description="Practical guides for Singapore SME owners: preparing to sell, valuation methods, succession planning, deal structures, tax and stamp duty, due diligence and more."
>
  <PageHeader
    eyebrow="Guides"
    title="Everything an owner needs to know before selling"
    intro="Written for owners doing this once, not for advisors. No sign-up, no gate."
    crumbs={crumbs}
  />

  <section class="max-w-wrap mx-auto px-5 lg:px-8 pb-28 lg:pb-40">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
      {guides.map((g, i) => (
        <a href={`/guides/${g.slug}`} class="reveal group rounded-[2rem] bg-black/5 dark:bg-white/[0.04] ring-1 ring-black/5 dark:ring-white/[0.08] p-1.5 transition-transform duration-700 ease hover:-translate-y-0.5" data-d={String((i % 2) + 1)}>
          <div class="rounded-core bg-white dark:bg-night-core p-8 h-full flex flex-col justify-between gap-6">
            <div>
              <h2 class="text-xl font-medium tracking-tight group-hover:text-accent dark:group-hover:text-[#7fd1b3] transition-colors duration-500 ease">{g.data.title}</h2>
              <p class="mt-3 text-sm text-ink-2 dark:text-[#a9b4c2] font-light">{g.data.description}</p>
            </div>
            <p class="font-mono text-xs text-ink-3 dark:text-[#a9b4c2]">{g.data.readingMinutes} min read</p>
          </div>
        </a>
      ))}
    </div>
  </section>

  <FinalCta />
</Base>
