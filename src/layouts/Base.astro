---
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import site from '../data/site.json';
import { organization, website, breadcrumbs } from '../lib/schema';
import Analytics from '@vercel/analytics/astro';

interface Props {
  title: string;
  description: string;
  /** Extra JSON-LD nodes to merge into the @graph for this page. */
  schema?: Record<string, unknown>[];
  /** Visible breadcrumb trail; also emitted as BreadcrumbList JSON-LD. */
  crumbs?: { href: string; label: string }[];
  ogImage?: string;
  noindex?: boolean;
  bodyClass?: string;
}

const {
  title,
  description,
  schema = [],
  crumbs = [],
  ogImage = '/images/og-share.jpg',
  noindex = false,
  bodyClass = '',
} = Astro.props;

const canonical = new URL(Astro.url.pathname.replace(/\/+$/, '') || '/', Astro.site).href;
const ogUrl = new URL(ogImage, Astro.site).href;

const crumbSchema = crumbs.length ? [breadcrumbs(crumbs)] : [];
const graph = {
  '@context': 'https://schema.org',
  '@graph': [organization(), website(), ...crumbSchema, ...schema],
};

// Optional analytics: only emitted when the domain is configured at build time,
// so the default build has no third-party origins at all.
const plausible = import.meta.env.PUBLIC_PLAUSIBLE_DOMAIN;
/** Vercel serves the analytics scripts from the deployment itself, so they only
 *  exist on a Vercel build. Gating on this keeps local builds free of two 404s. */
const onVercel = process.env.VERCEL === '1';
---

<!doctype html>
<html lang="en-SG" class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex
      ? <meta name="robots" content="noindex, follow" />
      : <meta name="robots" content="index, follow, max-snippet:-1, max-image-preview:large" />}

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogUrl} />
    <meta property="og:locale" content="en_SG" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogUrl} />

    <meta name="theme-color" content="#f6f7f4" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0b121c" media="(prefers-color-scheme: dark)" />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preload" href="/fonts/geist-var-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/geistmono-var-latin.woff2" as="font" type="font/woff2" crossorigin />

    {/* Literal child, not set:html: set:html HTML-escapes the quotes and ships
        a script that throws on every page. */}
    <script is:inline>document.documentElement.classList.add("js")</script>
    <script type="application/ld+json" set:html={JSON.stringify(graph)} />

    {plausible && (
      <script is:inline defer data-domain={plausible} src="https://plausible.io/js/script.outbound-links.js"></script>
    )}

    {/* Speed Insights. Vercel proxies it under /_vercel on this origin, so
        `script-src 'self'` already covers it and the CSP needs no third-party
        host. The beacon posts same-origin too. Web Analytics is the <Analytics />
        component at the end of <body>. */}
    {onVercel && <script is:inline defer src="/_vercel/speed-insights/script.js"></script>}
  </head>

  <body class={`font-sans antialiased ${bodyClass}`}>
    <a class="skip-link" href="#main">Skip to content</a>
    <div class="grain" aria-hidden="true"></div>

    <Nav />

    <main id="main">
      <slot />
    </main>

    <Footer />

    <script>
      // Scroll reveal. IntersectionObserver only, never a scroll listener.
      const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
      const nodes = document.querySelectorAll<HTMLElement>('.reveal');
      if (reduce || !('IntersectionObserver' in window)) {
        nodes.forEach((el) => el.classList.add('in'));
      } else {
        const io = new IntersectionObserver(
          (entries) =>
            entries.forEach((e) => {
              if (!e.isIntersecting) return;
              e.target.classList.add('in');
              io.unobserve(e.target);
            }),
          { threshold: 0.12, rootMargin: '0px 0px -6% 0px' }
        );
        nodes.forEach((el) => io.observe(el));
      }
    </script>

    {/* Web Analytics. The component rather than a bare script tag, because it
        calls computeRoute, so /sell/childcare and the other 19 report as one
        /sell/[sector] row instead of twenty. Astro bundles its script into
        /_astro, and the beacon it injects is same-origin under /_vercel, so
        `script-src 'self'` and `connect-src 'self'` already cover both. */}
    {onVercel && <Analytics />}
  </body>
</html>
