---
/**
 * Compact mid-page conversion band for sector and guide pages.
 *
 * Not the homepage ValuationTeaser: that one embeds the whole estimator, and
 * repeating a multi-step form on 20 sector pages would cost payload on every
 * one of them and split the funnel across duplicate forms. This links into the
 * single estimator with the sector pre-selected, and offers the email route
 * beside it, because a chunk of owners want a person rather than a calculator.
 */
import Shell from './Shell.astro';
import Button from './Button.astro';
import site from '../data/site.json';

interface Props {
  /** Slug from multiples.json, pre-selects the sector in the estimator. */
  sector?: string;
  label?: string;
  class?: string;
}
const { sector, label, class: className = '' } = Astro.props;
const href = sector ? `/valuation?sector=${sector}` : '/valuation';
const what = label ? `your ${label.toLowerCase()} business` : 'your business';
---

<Shell radius="2rem" class={`reveal ${className}`} coreClass="px-6 md:px-10 py-8 md:py-10">
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
    <div class="lg:col-span-7">
      <h2 class="text-2xl md:text-3xl font-medium tracking-[-0.02em]">What is {what} worth?</h2>
      <p class="mt-3 text-ink-2 dark:text-[#a9b4c2] font-light leading-relaxed max-w-[52ch]">
        Two minutes, six questions. You get an indicative range on screen straight away, and the full
        report by email. Confidential, and no obligation to do anything with it.
      </p>
    </div>
    <div class="lg:col-span-5 flex flex-col sm:flex-row lg:justify-end gap-3">
      <Button href={href} variant="accent" icon="calculator">Get my range</Button>
      <Button href={site.bookingUrl} variant="ring" icon="envelope-simple">Email an advisor</Button>
    </div>
  </div>
</Shell>
