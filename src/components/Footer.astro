---
import site from '../data/site.json';

const columns = [
  {
    heading: 'Sellers',
    links: [
      { href: '/sell-your-business', label: 'Sell your business' },
      { href: '/valuation', label: 'Valuation' },
      { href: '/exit-readiness', label: 'Exit readiness check' },
      { href: '/guides', label: 'Guides' },
      { href: '/data/sme-multiples-singapore', label: 'SME multiples data' },
      { href: '/case-studies', label: 'Transactions' },
    ],
  },
  {
    heading: 'Company',
    links: [
      { href: '/about', label: 'About' },
      { href: '/buyers', label: 'Buyers' },
      { href: '/insights', label: 'Insights' },
      { href: '/contact', label: 'Contact' },
      { href: '/book-a-call', label: 'Book a call' },
    ],
  },
];
const year = new Date().getFullYear();
---

<footer class="max-w-wrap mx-auto px-5 lg:px-8 pb-12">
  <div class="border-t border-black/5 dark:border-white/[0.08] pt-12 grid grid-cols-1 md:grid-cols-4 gap-10 text-sm">
    <div class="md:col-span-2">
      <p class="font-medium">{site.name}</p>
      <p class="mt-3 text-ink-3 dark:text-[#a9b4c2] max-w-[40ch] font-light">
        {site.name} is the sell-side M&amp;A practice of
        <a
          class="underline underline-offset-2 hover:text-ink dark:hover:text-paper transition-colors duration-500 ease"
          href={site.parentUrl}
          rel="noopener"
        >{site.parentLegal}</a>, Singapore.
      </p>
      <p class="mt-5 space-y-1 text-ink-3 dark:text-[#a9b4c2] font-light">
        <a class="block hover:text-ink dark:hover:text-paper transition-colors duration-500 ease" href={`tel:${site.phoneHref}`}>{site.phoneDisplay}</a>
        <a class="block hover:text-ink dark:hover:text-paper transition-colors duration-500 ease" href={`mailto:${site.email}`}>{site.email}</a>
      </p>
    </div>

    {columns.map((col) => (
      <div>
        <p class="font-medium">{col.heading}</p>
        <ul class="mt-4 space-y-2.5 text-ink-3 dark:text-[#a9b4c2] font-light">
          {col.links.map((l) => (
            <li>
              <a class="hover:text-ink dark:hover:text-paper transition-colors duration-500 ease" href={l.href}>{l.label}</a>
            </li>
          ))}
        </ul>
      </div>
    ))}
  </div>

  <div class="mt-12 flex flex-col md:flex-row md:items-center md:justify-between gap-3 text-xs text-ink-3 dark:text-[#a9b4c2]">
    <p>
      &copy; {year} {site.parentLegal}. Valuation estimates are indicative and not financial advice.
    </p>
    <p class="flex gap-5">
      <a class="hover:text-ink dark:hover:text-paper transition-colors duration-500 ease" href="/privacy">Privacy (PDPA)</a>
      <a class="hover:text-ink dark:hover:text-paper transition-colors duration-500 ease" href="/terms">Terms</a>
    </p>
  </div>
</footer>
