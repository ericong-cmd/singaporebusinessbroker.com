---
import Button from '../Button.astro';
import buyers from '../../data/buyers.json';

const rows = buyers.rows.slice(0, 4);
---

<section id="buyers" class="max-w-wrap mx-auto px-5 lg:px-8">
  <div class="rounded-[2.5rem] bg-ink dark:bg-night-2 text-paper px-6 md:px-14 py-20 lg:py-28 relative overflow-hidden grid grid-cols-1 lg:grid-cols-12 gap-12">
    <div class="absolute -bottom-40 -left-32 w-[560px] h-[560px] rounded-full bg-accent/20 blur-3xl pointer-events-none" aria-hidden="true"></div>
    <div class="relative lg:col-span-5 reveal">
      <h2 class="text-3xl md:text-5xl font-medium tracking-[-0.03em] leading-[1.05]">Buyers currently looking</h2>
      <p class="mt-6 text-lg text-paper/65 leading-relaxed font-light">
        Live mandates from our buyer network. If your business fits, we can make an introduction quickly.
        <span class="font-mono text-xs">(sample rows)</span>
      </p>
      <div class="mt-10"><Button href="/book-a-call" variant="inverse">Book a confidential call</Button></div>
    </div>
    <div class="relative lg:col-span-7 grid gap-3">
      {rows.map((r, i) => (
        <div class="rounded-[1.5rem] bg-white/5 ring-1 ring-white/10 p-1.5 reveal transition-transform duration-700 ease hover:-translate-y-0.5" data-d={String(i)}>
          <div class="rounded-[calc(1.5rem-0.375rem)] bg-white/5 p-5 grid grid-cols-[1fr_auto] gap-4 items-center">
            <div>
              <p class="font-medium">{r.title}</p>
              <p class="mt-1 text-sm text-paper/55 font-light">{r.detail}</p>
            </div>
            <p class="font-mono text-sm whitespace-nowrap">{r.range}</p>
          </div>
        </div>
      ))}
      <p class="mt-2 text-sm text-paper/55 font-light">
        <a class="underline hover:text-paper" href="/buyers">See all buyer mandates</a>
      </p>
    </div>
  </div>
</section>
