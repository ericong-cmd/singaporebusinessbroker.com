---
import Button from '../Button.astro';
import Eyebrow from '../Eyebrow.astro';
import Shell from '../Shell.astro';
import site from '../../data/site.json';
---

<section class="relative overflow-hidden min-h-[100dvh] flex items-center">
  <div class="orb absolute -top-40 -left-40 w-[640px] h-[640px] rounded-full bg-accent/10 dark:opacity-35 blur-3xl pointer-events-none" aria-hidden="true"></div>
  <div class="orb orb2 absolute top-1/2 -right-56 w-[720px] h-[720px] rounded-full bg-[#c9d8cf]/40 dark:opacity-35 blur-3xl pointer-events-none" aria-hidden="true"></div>

  <div class="relative max-w-wrap mx-auto px-5 lg:px-8 pt-32 pb-20 lg:pt-36 lg:pb-28 grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-6 items-center w-full">
    <div class="lg:col-span-6 reveal">
      <Eyebrow dot>Sell-side M&amp;A, Singapore SMEs</Eyebrow>
      <h1 class="mt-7 text-[2.6rem] leading-[1.02] md:text-6xl xl:text-[4rem] font-medium tracking-[-0.03em]">
        Sell your business confidentially, at the right price.
      </h1>
      <p class="mt-7 text-lg md:text-xl text-ink-2 dark:text-[#a9b4c2] leading-relaxed max-w-[46ch] font-light">
        We run the sale for Singapore businesses worth {site.dealRange}. Valuation, buyer search, negotiation, close.
      </p>
      <div class="mt-10 flex flex-col sm:flex-row gap-3">
        <Button href="/valuation" variant="ink">Get free valuation</Button>
        <Button href="/book-a-call" variant="ring" icon="phone">Book a confidential call</Button>
      </div>
    </div>

    <div class="lg:col-span-6 relative reveal" data-d="1">
      <Shell radius="2rem" pad="2" shadow="frame">
        <div class="overflow-hidden aspect-[5/4] shadow-bezelSoft" style="border-radius:calc(2rem - 0.5rem)">
          <img
            src="/images/hero-owner.webp"
            srcset="/images/hero-owner@720.webp 731w, /images/hero-owner.webp 1170w"
            sizes="(min-width: 1024px) 46vw, 92vw"
            width="1170" height="936"
            alt="A Singapore business owner in his office"
            class="hero-img w-full h-full object-cover"
            loading="eager" fetchpriority="high" decoding="async"
          />
        </div>
      </Shell>

      <div class="absolute -bottom-8 -left-3 lg:-left-12 rounded-[1.5rem] bg-white/70 dark:bg-night/70 backdrop-blur-xl ring-1 ring-black/5 dark:ring-white/[0.08] p-1.5 shadow-soft max-w-[300px] reveal" data-d="3">
        <div class="rounded-[calc(1.5rem-0.375rem)] bg-white dark:bg-night-core p-5 shadow-bezel">
          <p class="text-[10px] uppercase tracking-[0.18em] text-ink-3 dark:text-[#a9b4c2]">
            Estimated value <span class="font-mono normal-case tracking-normal">(sample)</span>
          </p>
          <p class="mt-2 font-mono text-2xl tracking-tight">S$4.2m to S$6.1m</p>
          <p class="mt-2 text-xs text-ink-3 dark:text-[#a9b4c2]">Logistics, S$7.8m revenue, 12 years operating</p>
        </div>
      </div>
    </div>
  </div>
</section>
