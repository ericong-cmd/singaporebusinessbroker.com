---
/**
 * Second conversion path on the home page.
 *
 * It sits immediately after the valuation estimator on purpose. The estimator
 * asks for revenue, profit and a contact detail, which is a real commitment
 * from someone still deciding whether to sell at all. This offers the same
 * visitor a lower-friction next step: ten yes or no questions, a score, no
 * email. Owners who are two years out take this one, and the estimator later.
 */
import Shell from '../Shell.astro';
import Button from '../Button.astro';
import Icon from '../Icon.astro';
import quiz from '../../data/exitReadiness.json';

// Shown as proof the check is specific rather than a generic lead form.
const preview = [
  'Could the business run for three months without you?',
  'Do you have three years of clean, reviewed financial statements?',
  'Does your largest customer account for less than 30 percent of revenue?',
];
const total = quiz.questions.length;
---

<section class="max-w-wrap mx-auto px-5 lg:px-8 pb-28 lg:pb-40">
  <Shell radius="2.5rem" class="reveal" coreClass="px-6 md:px-12 py-12 md:py-16">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-16 items-center">
      <div class="lg:col-span-7">
        <p class="text-[10px] uppercase tracking-[0.18em] text-accent dark:text-[#7fd1b3]">Free, no email required</p>
        <h2 class="mt-5 text-3xl md:text-5xl font-medium tracking-[-0.03em] leading-[1.05]">
          Not sure you are ready to sell yet?
        </h2>
        <p class="mt-6 text-lg text-ink-2 dark:text-[#a9b4c2] leading-relaxed font-light max-w-[52ch]">
          Most owners are twelve to twenty-four months away when they first ask. {total} questions,
          about three minutes, and a score out of 100 against what a buyer actually checks before
          they price your business.
        </p>

        <ul class="mt-8 space-y-3">
          {preview.map((q) => (
            <li class="flex gap-3 text-sm text-ink-2 dark:text-[#a9b4c2] font-light">
              <Icon name="check-circle" class="text-accent dark:text-[#7fd1b3] text-lg shrink-0 mt-0.5" />
              <span>{q}</span>
            </li>
          ))}
          <li class="flex gap-3 text-sm text-ink-3 dark:text-[#a9b4c2] font-light">
            <span class="w-[18px] shrink-0" aria-hidden="true"></span>
            <span>and {total - preview.length} more</span>
          </li>
        </ul>

        <div class="mt-10 flex flex-col sm:flex-row gap-3">
          <Button href="/exit-readiness" variant="accent" icon="arrow-right">Check my readiness</Button>
          <Button href="/guides" variant="ring">Browse the guides</Button>
        </div>
      </div>

      <div class="lg:col-span-5">
        <div class="rounded-[2rem] bg-accent-soft dark:bg-night-soft p-8 md:p-10">
          <p class="text-[10px] uppercase tracking-[0.18em] text-accent-2 dark:text-[#7fd1b3]">Your result</p>
          <p class="mt-4 flex items-baseline gap-2">
            <span class="font-mono text-5xl md:text-6xl tracking-tight text-accent-2 dark:text-[#7fd1b3]">62</span>
            <span class="font-mono text-xl text-accent-2/60 dark:text-[#7fd1b3]/60">/ 100</span>
          </p>
          <p class="mt-4 font-medium text-ink dark:text-paper">Fixable gaps</p>
          <p class="mt-3 text-sm text-ink-2 dark:text-[#a9b4c2] font-light leading-relaxed">
            Two or three issues would be found in due diligence and used to reprice the deal. Found and
            fixed now, they cost you preparation time. Found by a buyer, they cost you money.
          </p>
          <p class="mt-6 font-mono text-[11px] text-ink-3 dark:text-[#a9b4c2]">Example result</p>
        </div>
      </div>
    </div>
  </Shell>
</section>
