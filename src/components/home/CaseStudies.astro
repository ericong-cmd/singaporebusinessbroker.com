---
import { getCollection } from 'astro:content';

const all = (await getCollection('cases')).sort((a, b) => a.data.order - b.data.order);
const featured = all.find((c) => c.data.featured) ?? all[0];
const rest = all.filter((c) => c.id !== featured.id).slice(0, 2);
---

<section id="cases" class="max-w-wrap mx-auto px-5 lg:px-8 pb-28 lg:pb-40">
  <div class="max-w-[60ch] reveal">
    <h2 class="text-3xl md:text-5xl font-medium tracking-[-0.03em] leading-[1.05]">Recent transactions</h2>
    <p class="mt-6 text-lg text-ink-2 dark:text-[#a9b4c2] font-light">
      Anonymised. Sector, size and outcome only. <span class="font-mono text-xs">(sample entries)</span>
    </p>
  </div>

  <div class="mt-16 grid grid-cols-1 lg:grid-cols-12 gap-6 lg:gap-0 items-center">
    <article class="lg:col-span-7 rounded-[2rem] bg-black/5 dark:bg-white/[0.04] ring-1 ring-black/5 dark:ring-white/[0.08] p-1.5 shadow-frame reveal lg:relative lg:z-10">
      <div class="group rounded-core overflow-hidden bg-white dark:bg-night-core grid md:grid-cols-2">
        <div class="overflow-hidden h-64 md:h-full">
          <img
            src={featured.data.image}
            srcset="/images/logistics-warehouse@560.webp 560w, /images/logistics-warehouse.webp 900w"
            sizes="(min-width: 768px) 30vw, 92vw"
            width="900" height="900"
            alt=""
            class="w-full h-full object-cover transition-transform duration-[1600ms] ease group-hover:scale-[1.04]"
            loading="lazy" decoding="async"
          />
        </div>
        <div class="p-8 flex flex-col justify-between">
          <div>
            <p class="text-[10px] uppercase tracking-[0.18em] text-ink-3 dark:text-[#a9b4c2]">{featured.data.sectorLabel}</p>
            <h3 class="mt-3 text-2xl font-medium tracking-tight">
              <a class="hover:text-accent dark:hover:text-[#7fd1b3] transition-colors duration-500 ease" href={`/case-studies/${featured.slug}`}>
                {featured.data.title}
              </a>
            </h3>
            <p class="mt-4 text-sm text-ink-2 dark:text-[#a9b4c2] leading-relaxed font-light">{featured.data.description}</p>
          </div>
          <dl class="mt-8 grid grid-cols-2 gap-4 text-sm">
            <div><dt class="text-ink-3 dark:text-[#a9b4c2] text-xs">Revenue</dt><dd class="font-mono mt-1">{featured.data.revenue}</dd></div>
            <div><dt class="text-ink-3 dark:text-[#a9b4c2] text-xs">Time to close</dt><dd class="font-mono mt-1">{featured.data.timeToClose}</dd></div>
          </dl>
        </div>
      </div>
    </article>

    <div class="lg:col-span-5 grid gap-6 lg:-ml-10">
      {rest.map((c, i) => (
        <article
          class:list={[
            'rounded-[2rem] bg-black/5 dark:bg-white/[0.04] ring-1 ring-black/5 dark:ring-white/[0.08] p-1.5 reveal transition-transform duration-700 ease',
            i === 0
              ? 'lg:rotate-[1.5deg] lg:translate-x-6 hover:rotate-0 hover:translate-x-0'
              : 'lg:-rotate-[1.5deg] lg:translate-x-12 hover:rotate-0 hover:translate-x-6',
          ]}
          data-d={String(i + 1)}
        >
          <div class="rounded-core bg-white dark:bg-night-core p-8 shadow-bezel">
            <p class="text-[10px] uppercase tracking-[0.18em] text-ink-3 dark:text-[#a9b4c2]">{c.data.sectorLabel}</p>
            <h3 class="mt-3 text-xl font-medium tracking-tight">
              <a class="hover:text-accent dark:hover:text-[#7fd1b3] transition-colors duration-500 ease" href={`/case-studies/${c.slug}`}>{c.data.title}</a>
            </h3>
            <p class="mt-3 text-sm text-ink-2 dark:text-[#a9b4c2] font-light">{c.data.outcome}</p>
            <p class="mt-5 font-mono text-sm">{c.data.revenue}</p>
          </div>
        </article>
      ))}
    </div>
  </div>

  <div class="mt-12 reveal">
    <a class="text-sm font-medium text-accent dark:text-[#7fd1b3] hover:underline" href="/case-studies">All transactions</a>
  </div>
</section>
