---
import Shell from '../Shell.astro';
import stats from '../../data/stats.json';
---

<section class="max-w-wrap mx-auto px-5 lg:px-8 pt-24 lg:pt-32" aria-label="Key figures">
  <Shell radius="2rem" class="reveal" coreClass="px-6 md:px-10 py-10 grid grid-cols-2 md:grid-cols-4 gap-8 md:divide-x divide-black/5 dark:divide-white/[0.08]">
    {stats.map((s, i) => (
      <div class={i === 0 ? 'md:pl-0' : 'md:pl-8'}>
        <p class="font-mono text-2xl md:text-3xl tracking-tight">{s.value}</p>
        <p class="mt-2 text-sm text-ink-3 dark:text-[#a9b4c2] font-light">{s.label}</p>
      </div>
    ))}
  </Shell>
</section>
