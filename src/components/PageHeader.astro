---
import Eyebrow from './Eyebrow.astro';

interface Props {
  eyebrow?: string;
  title: string;
  intro?: string;
  crumbs?: { href: string; label: string }[];
}
const { eyebrow, title, intro, crumbs = [] } = Astro.props;
---

<section class="relative overflow-hidden">
  <div class="orb absolute -top-40 -right-40 w-[560px] h-[560px] rounded-full bg-accent/10 dark:opacity-35 blur-3xl pointer-events-none" aria-hidden="true"></div>
  <div class="relative max-w-wrap mx-auto px-5 lg:px-8 pt-36 pb-16 lg:pt-44 lg:pb-24">
    {crumbs.length > 0 && (
      <nav aria-label="Breadcrumb" class="mb-6 text-xs text-ink-3 dark:text-[#a9b4c2] reveal">
        <ol class="flex flex-wrap gap-2">
          <li><a class="hover:text-accent dark:hover:text-[#7fd1b3]" href="/">Home</a></li>
          {crumbs.map((c, i) => (
            <li class="flex gap-2">
              <span aria-hidden="true" class="opacity-50">/</span>
              {i === crumbs.length - 1
                ? <span aria-current="page">{c.label}</span>
                : <a class="hover:text-accent dark:hover:text-[#7fd1b3]" href={c.href}>{c.label}</a>}
            </li>
          ))}
        </ol>
      </nav>
    )}
    <div class="reveal">
      {eyebrow && <Eyebrow dot>{eyebrow}</Eyebrow>}
      <h1 class="mt-6 text-[2.3rem] leading-[1.05] md:text-5xl xl:text-[3.4rem] font-medium tracking-[-0.03em] max-w-[20ch]">
        {title}
      </h1>
      {intro && (
        <p class="mt-6 text-lg md:text-xl text-ink-2 dark:text-[#a9b4c2] leading-relaxed max-w-[58ch] font-light">{intro}</p>
      )}
      <div class="mt-8"><slot /></div>
    </div>
  </div>
</section>
