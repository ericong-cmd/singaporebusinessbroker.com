---
import Icon from './Icon.astro';
import site from '../data/site.json';

const links = [
  { href: '/sell-your-business', label: 'Sell' },
  { href: '/valuation', label: 'Valuation' },
  { href: '/case-studies', label: 'Transactions' },
  { href: '/guides', label: 'Guides' },
  { href: '/buyers', label: 'Buyers' },
  { href: '/about', label: 'About' },
];

const path = Astro.url.pathname.replace(/\/+$/, '') || '/';
const isCurrent = (href: string) => path === href || path.startsWith(href + '/');
---

<header class="fixed inset-x-0 top-0 z-40 pointer-events-none">
  <div class="mx-auto mt-5 px-4 flex justify-center">
    <div
      class="pointer-events-auto flex items-center gap-1 rounded-full bg-white/70 dark:bg-night/70 backdrop-blur-xl ring-1 ring-black/5 dark:ring-white/[0.08] shadow-pill pl-4 pr-1.5 py-1.5"
    >
      <a href="/" class="flex items-center gap-2.5 pr-3" aria-label={`${site.name} home`}>
        <span
          class="grid place-items-center w-7 h-7 rounded-full bg-ink dark:bg-paper-2 text-paper dark:text-night text-[11px] font-medium"
          >SB</span
        >
        <span class="text-sm font-medium tracking-tight hidden sm:block">{site.name}</span>
      </a>

      <nav class="hidden lg:flex items-center text-[13px] text-ink-2 dark:text-[#a9b4c2]" aria-label="Main">
        {links.map((l) => (
          <a
            href={l.href}
            aria-current={isCurrent(l.href) ? 'page' : undefined}
            class:list={[
              'px-3 py-2 rounded-full transition-colors duration-500 ease hover:bg-black/5 dark:hover:bg-white/10',
              isCurrent(l.href) && 'text-accent dark:text-[#7fd1b3] bg-black/[0.04] dark:bg-white/[0.06]',
            ]}
          >
            {l.label}
          </a>
        ))}
      </nav>

      <a
        href="/valuation"
        class="group ml-1 hidden sm:inline-flex items-center gap-2 rounded-full bg-accent text-white text-[13px] font-medium pl-4 pr-1.5 py-1.5 transition-transform duration-500 ease active:scale-[0.98]"
      >
        Free valuation
        <span
          class="grid place-items-center w-7 h-7 rounded-full bg-white/15 transition-transform duration-500 ease group-hover:translate-x-0.5 group-hover:-translate-y-px group-hover:scale-105"
        >
          <Icon name="arrow-up-right" class="text-base" />
        </span>
      </a>

      <button
        id="burger"
        class="lg:hidden relative w-10 h-10 rounded-full hover:bg-black/5 dark:hover:bg-white/10"
        aria-label="Open menu"
        aria-expanded="false"
        aria-controls="menu"
      >
        <span></span><span></span><span></span>
      </button>
    </div>
  </div>
</header>

<div id="menu" class="fixed inset-0 z-30 hidden bg-paper/85 dark:bg-night/85 backdrop-blur-3xl">
  <nav class="h-full flex flex-col justify-center px-8 gap-2 text-4xl font-medium tracking-tight" aria-label="Mobile">
    {links.map((l) => <a href={l.href}>{l.label === 'Sell' ? 'Sell your business' : l.label}</a>)}
    <a href="/book-a-call">Book a call</a>
  </nav>
</div>

<script>
  const burger = document.getElementById('burger');
  const menu = document.getElementById('menu');
  if (burger && menu) {
    const setOpen = (open: boolean) => {
      burger.classList.toggle('open', open);
      burger.setAttribute('aria-expanded', String(open));
      burger.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
      if (open) {
        menu.classList.remove('hidden');
        requestAnimationFrame(() => requestAnimationFrame(() => menu.classList.add('open')));
        document.body.style.overflow = 'hidden';
      } else {
        menu.classList.remove('open');
        setTimeout(() => menu.classList.add('hidden'), 400);
        document.body.style.overflow = '';
      }
    };
    burger.addEventListener('click', () => setOpen(!burger.classList.contains('open')));
    menu.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => setOpen(false)));
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && burger.classList.contains('open')) {
        setOpen(false);
        burger.focus();
      }
    });
  }
</script>
