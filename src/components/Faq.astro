---
import Icon from './Icon.astro';
import Shell from './Shell.astro';

interface Props {
  items: { q: string; a: string }[];
  heading?: string;
  class?: string;
}
const { items, heading = 'Questions owners ask first', class: className = '' } = Astro.props;
---

<section id="faq" class={`max-w-wrap mx-auto px-5 lg:px-8 py-28 lg:py-40 grid grid-cols-1 lg:grid-cols-12 gap-12 ${className}`}>
  <div class="lg:col-span-4 reveal">
    <h2 class="text-3xl md:text-5xl font-medium tracking-[-0.03em] leading-[1.05]">{heading}</h2>
  </div>
  <Shell
    radius="2rem"
    class="lg:col-span-8 reveal"
    coreClass="px-6 md:px-8 divide-y divide-black/5 dark:divide-white/[0.08]"
  >
    {items.map((f) => (
      <details class="group py-6">
        <summary class="flex justify-between items-center cursor-pointer font-medium gap-6">
          {f.q}
          <span class="grid place-items-center w-8 h-8 rounded-full bg-black/5 dark:bg-white/10 shrink-0">
            <Icon name="plus" class="chev" />
          </span>
        </summary>
        <p class="mt-4 text-sm text-ink-2 dark:text-[#a9b4c2] leading-relaxed max-w-[65ch] font-light">{f.a}</p>
      </details>
    ))}
  </Shell>
</section>
