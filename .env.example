# All integrations are optional. With none set, the API endpoints still
# validate and score submissions and return 200, so the site works on a fresh
# deployment; nothing is delivered anywhere.

# --- Transactional email (Resend) -------------------------------------------
RESEND_API_KEY=
# Verified sender, e.g. "Singapore Business Broker <hello@singaporebusinessbroker.com>"
MAIL_FROM=
# Where hot-lead alerts and contact enquiries go
TEAM_EMAIL=Contact-us@thefundingassembly.com

# --- CRM (Airtable; swap crmUpsert in api/_lib.ts for HubSpot) --------------
AIRTABLE_TOKEN=
AIRTABLE_BASE_ID=
AIRTABLE_TABLE=Leads

# --- Alerts -----------------------------------------------------------------
SLACK_WEBHOOK_URL=

# --- Analytics (build time; leave unset for no third-party scripts) ---------
# Setting this also requires widening the CSP in vercel.json to allow
# plausible.io for script-src and connect-src.
PUBLIC_PLAUSIBLE_DOMAIN=
